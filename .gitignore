# Unity-generated state for Demo and Tool projects.
**/UnityProject/[Ll]ibrary/
**/UnityProject/[Tt]emp/
**/UnityProject/[Oo]bj/
**/UnityProject/[Ll]ogs/
**/UnityProject/[Uu]ser[Ss]ettings/
**/UnityProject/[Mm]emoryCaptures/
**/UnityProject/[Rr]ecordings/
**/UnityProject/[Ee]xported[Oo]bj/
**/UnityProject/*_BurstDebugInformation_DoNotShip/
**/UnityProject/*_BackUpThisFolder_ButDontShipItWithYourGame/

# Rebuildable players. Keep build scripts and Assets/** in version control.
/Demo/*/[Bb]uild/
/Demo/*/[Bb]uilds/
**/UnityProject/[Bb]uild/
**/UnityProject/[Bb]uilds/

# IDE-generated projects and per-user state.
.vs/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.opendb
*.VC.db

# Python caches, Blender backups, and local logs.
__pycache__/
*.pyc
*.pyo
.venv/
*.blend[0-9]*
*.blend@
*.log

# Local QA backups and machine-specific delivery inventories.
**/QA/backups/
**/QA/delivery-manifest.json
# Keep audit JSON and documented QA/runtime screenshots and reports.
/Demo/*/QA/AssetPreparation/**/*.blend
/Demo/*/QA/AssetPreparation/**/*.fbx

# OS-generated files.
.DS_Store
Thumbs.db
Desktop.ini

# Tool players / Unity distribution packages can be reproduced from source.
/Tool/*/[Bb]uild/
/Tool/*/[Bb]uilds/
/Tool/*/Export/*.unitypackage
/Tool/*/QA/BuildCandidate/
/Tool/*/QA/Diagnostics/

# Keep the extracted source meshes and licences; omit duplicate download archives.
/Tool/*/Source/Downloads/*.zip
/Tool/*/Source/Downloads/*.7z
/Tool/*/Source/Downloads/*.rar

# Keep review contact sheets, native UI evidence and TXT/JSON reports.
# Reproducible frame sequences stay local; no files are deleted by these rules.
/Tool/V2/QA/Runtime/*.png
/Tool/V2/QA/HairFinal/*.png
/Tool/V2/QA/AlienFinal/*.png
/Tool/V2/QA/OutfitFinal/*.png
