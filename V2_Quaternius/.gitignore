# Shared Unity, build, IDE, and backup rules live in ../.gitignore.

# Bulk visual-review captures, frame indexes, and generated contact sheets.
# Keep QA/runtime screenshots and reports used by the documentation.
/QA/visual-review/

# Download archives and redundant engine exports.
# Keep the original Humans_Master_Humanoid.blend used by build_cast.py,
# all licenses/setup guides, and the imported animation inside Assets/.
/Source/Downloads/*.html
/Source/Downloads/*.js
/Source/Downloads/*.zip
/Source/Downloads/**/*.fbx
/Source/Downloads/**/*.glb
